{
  "name": "@arhilab/backend",
  "version": "0.7.0-dev.1",
  "private": true,
  "type": "module",
  "description": "Arhilab Смета API architecture foundation",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "migrate:up": "node-pg-migrate up --migrations-dir migrations --check-order",
    "migrate:down": "node-pg-migrate down --migrations-dir migrations",
    "migrate:test": "bash scripts/migration-test.sh",
    "seed:dev": "node --import tsx scripts/seed-development.ts"
  },
  "dependencies": {
    "cors": "2.8.5",
    "dotenv": "17.2.3",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "eslint": "10.11.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  }
}
